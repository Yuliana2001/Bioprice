BIOPRICE_ENVIRONMENT=development
BIOPRICE_DATABASE_URL=postgresql+psycopg://bioprice_user:CHANGE_ME@127.0.0.1:5432/bioprice
BIOPRICE_AUTH_SECRET_KEY=
BIOPRICE_SESSION_TTL_MINUTES=480
BIOPRICE_PASSWORD_RESET_TTL_MINUTES=30
BIOPRICE_CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]
BIOPRICE_FRONTEND_BASE_URL=http://127.0.0.1:4200
BIOPRICE_SMTP_HOST=
BIOPRICE_SMTP_PORT=587
BIOPRICE_SMTP_USERNAME=
BIOPRICE_SMTP_PASSWORD=
BIOPRICE_SMTP_SENDER=
BIOPRICE_SMTP_STARTTLS=true
BIOPRICE_SMTP_TIMEOUT_SECONDS=10
BIOPRICE_ANALYTICS_DATA_DIR=./data/analytics
BIOPRICE_DUCKDB_MEMORY_LIMIT=1GB
BIOPRICE_DUCKDB_THREADS=2
